 & 100 & $+1.836$ \; $[+1.59, +2.08]$ & $+1.819$ \; $[+1.58, +2.08]$ & $+0.018$ \\
 & 150 & $+1.946$ \; $[+1.65, +2.24]$ & $+1.461$ \; $[+1.21, +1.71]$ & $+0.486$ \\
 & 200 & $+2.085$ \; $[+1.83, +2.35]$ & $+1.501$ \; $[+1.27, +1.74]$ & $+0.584$ \\
 & 250 & $+2.080$ \; $[+1.81, +2.34]$ & $+1.425$ \; $[+1.17, +1.71]$ & $+0.656$ \\
\midrule
\multirow{5}{*}{\; + plan-forecast + TE-KL}
